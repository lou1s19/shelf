{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Shelf",
	"mainBinaryName": "Shelf",
	"identifier": "de.shelf.desktop",
	"build": {
		"beforeBundleCommand": "node scripts/prodBeforeBundle.js"
	},
	"plugins": {
		"updater": {
			"comment": "Shelf's own feed. The pubkey below is the public half of ~/.shelf-licensing/tauri-update.key; an update that is not signed with that key is refused, so a hijacked domain cannot install anything. dialog is false because Shelf shows its own update window.",
			"active": true,
			"endpoints": ["https://shelf-website-mu.vercel.app/updates/latest.json"],
			"dialog": false,
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI5NjY3NTkzMUQ1REY4MjQKUldRaytGMGRrM1ZtS1JBNUVEZFl1Vzc3NlQwaDFnMXhoZk1QK1NCMXlDY3Q2R09iYTY2eWtiQWcK"
		}
	},
	"bundle": {
		"createUpdaterArtifacts": true,
		"macOS": {
			"entitlements": "Entitlements.plist"
		},
		"windows": {
			"wix": {
				"upgradeCode": "a765d9de-0ecc-55d0-b8a0-61e9d3276664"
			}
		}
	}
}
